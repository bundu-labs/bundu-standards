# The build happens inside the image; shipping the host's build output makes the context
# hundreds of megabytes and slows every deploy.
**/target/
.git/
.github/
**/node_modules/

# Local files the images do not need. (Not *.md: the standards' READMEs and register/REGISTER.md
# are inputs to the standards build. The Dockerfile builds either site from the root.)
.env
.env.*
docs/
ecosystem/
tools/
