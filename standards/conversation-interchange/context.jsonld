{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "bundu": "https://vocab.bundu.org/",
    "bci": "https://standards.bundu.org/conversation-interchange/0.1.0/",
    "Conversation": "schema:Conversation",
    "Message": "schema:Message",
    "Project": "bundu:Project",
    "Artifact": "bundu:Artifact",
    "MemoryEntry": "bundu:MemoryEntry",
    "id": "@id",
    "type": "@type",
    "title": "schema:name",
    "name": "schema:name",
    "created": { "@id": "schema:dateCreated", "@type": "schema:DateTime" },
    "updated": { "@id": "schema:dateModified", "@type": "schema:DateTime" },
    "language": "schema:inLanguage",
    "text": "schema:text",
    "mediaType": "schema:encodingFormat",
    "license": "schema:license",
    "citations": { "@id": "schema:citation", "@container": "@set" },
    "headline": "schema:headline",
    "publisher": "schema:publisher",
    "datePublished": "schema:datePublished",
    "validFrom": "schema:validFrom",
    "url": "schema:url",
    "conversation": { "@id": "bci:conversation", "@type": "@id" },
    "project": { "@id": "bci:project", "@type": "@id" },
    "scope": "bundu:scope",
    "sequence": "bci:sequence",
    "pinned": "bundu:pinned",
    "instructions": "bundu:instructions",
    "skills": { "@id": "bundu:skill", "@container": "@set" },
    "provenance": "bundu:provenance",
    "consent": "bundu:consent"
  }
}
