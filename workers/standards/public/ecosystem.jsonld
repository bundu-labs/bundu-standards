  },
  "hasPart": [
    {
      "@type": "NGO",
      "@id": "https://standards.bundu.org/ecosystem#bundu-foundation",
      "identifier": "bundu-foundation",
      "name": "Bundu Foundation",
      "description": "The umbrella of the ecosystem. It governs the four pillars, holds their intellectual property, and publishes the ecosystem's open standards. Bundu is Shona for wilderness.",
      "version": "1.0.0",
      "dateModified": "2026-11-17",
      "url": "https://www.bundu.org",
      "slogan": "umbrella",
      "subOrganization": [
        {
          "@id": "https://standards.bundu.org/ecosystem#bundu-labs"
        },
        {
          "@id": "https://standards.bundu.org/ecosystem#nyuchi-africa"
        },
        {
          "@id": "https://standards.bundu.org/ecosystem#mukoko"
        },
        {
          "@id": "https://standards.bundu.org/ecosystem#shamwari-ai"
        }
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://standards.bundu.org/ecosystem#bundu-labs",
      "identifier": "bundu-labs",
      "name": "Bundu Labs",
      "description": "The research and standards arm of the Bundu Foundation. It investigates infrastructure gaps across Africa and emerging markets, and publishes the standards, frameworks and vocabulary the rest of the ecosystem builds on.",
      "version": "1.0.0",
      "dateModified": "2026-11-17",
      "url": "https://www.bundu.org/research",
      "slogan": "Research, knowledge, standards and frameworks",
      "parentOrganization": {
        "@id": "https://standards.bundu.org/ecosystem#bundu-foundation"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Researchers, standards bodies, educators, the public"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://standards.bundu.org/ecosystem#nyuchi-africa",
      "identifier": "nyuchi-africa",
      "name": "Nyuchi Africa",
      "description": "The platform and infrastructure company of the ecosystem: the Nyuchi API, the console, and its own tools and products. Nyuchi builds and sells Mukoko and Shamwari AI, and builds Mzizi. It builds platforms others build on; it is not an outsourced IT department or a managed service provider.",
      "version": "1.0.0",
      "dateModified": "2026-11-17",
      "url": "https://www.nyuchi.com",
      "slogan": "Platform and infrastructure",
      "parentOrganization": {
        "@id": "https://standards.bundu.org/ecosystem#bundu-foundation"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Developers and businesses building digital services; micro and small businesses and informal traders; governments and institutions that extend access"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://standards.bundu.org/ecosystem#mukoko",
      "identifier": "mukoko",
      "name": "Mukoko",
      "description": "One consumer platform with its apps inside, as Microsoft 365 or Google Workspace hold theirs: a super app, with apps that also stand alone in their own domains. Built and sold by Nyuchi, on the Nyuchi API.",
      "version": "1.0.0",
      "dateModified": "2026-11-17",
      "url": "https://www.mukoko.com",
      "slogan": "The consumer pillar",
      "parentOrganization": {
        "@id": "https://standards.bundu.org/ecosystem#bundu-foundation"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Individuals, families and communities"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://standards.bundu.org/ecosystem#shamwari-ai",
      "identifier": "shamwari-ai",
      "name": "Shamwari AI",
      "description": "An African AI companion that answers in Shona, Ndebele and English and cites its sources. A pillar and a Bundu Foundation open-source project; it runs on Nyuchi's AI layer and is sold by Nyuchi.",
      "version": "1.0.0",
      "dateModified": "2026-11-17",
      "url": "https://shamwari.ai",
      "slogan": "Community-facing AI and conversational experiences",
      "parentOrganization": {
        "@id": "https://standards.bundu.org/ecosystem#bundu-foundation"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Communities and individuals, in Shona, Ndebele and English"
      }
    },
    {
      "@type": "CreativeWork",
      "@id": "https://standards.bundu.org/ecosystem#ubuntu",
      "identifier": "ubuntu",
      "name": "Ubuntu",
      "description": "Ubuntu is not a marketing claim; it is the specification. Its five pillars are the spheres of belonging and its five principles the values practised in them; seven engineering constraints make them testable. All three are served by Mzizi.",
      "version": "1.0.0",
      "dateModified": "2026-11-17",
      "creativeWorkStatus": "Canonical",
      "maintainer": {
        "@id": "https://standards.bundu.org/ecosystem#bundu-foundation"
      }
    },
    {
      "@type": "CreativeWork",
      "@id": "https://standards.bundu.org/ecosystem#mzizi",
      "identifier": "mzizi",
      "name": "Mzizi",
      "description": "The open design system every surface in the ecosystem is built with: components, tokens, a registry API and the Rust components (Mzizi Roots). Owned by the Bundu Foundation, built by Nyuchi, shared by all four pillars.",
      "version": "1.0.0",
      "dateModified": "2026-11-17",
      "url": "https://mzizi.dev",
      "creativeWorkStatus": "Live",
      "maintainer": {
        "@id": "https://standards.bundu.org/ecosystem#bundu-foundation"
      },
      "creator": {
        "@id": "https://standards.bundu.org/ecosystem#nyuchi-africa"
      }
    },
    {
      "@type": "CreativeWork",
      "@id": "https://standards.bundu.org/ecosystem#cell",
      "identifier": "cell",
      "name": ".cell",
      "description": "The data store for one entity (a person, a household or a business): one JSON-LD document with Markdown inside, stored as a .cell file or as a database row with the same bytes, structured so its data and text cannot diverge. A Foundation project like Mzizi; it maps directly to SiafuDB: on the device and at the edge a cell is a SiafuDB node, and SiafuDB sync carries it to the cloud and the honeycomb. Its reference implementation is being written in Rust. Proposed, not adopted (bundu-labs/bundu-standards#107).",
      "version": "0.1.0",
      "dateModified": "2026-11-17",
      "url": "https://github.com/siafuDB/cell",
      "creativeWorkStatus": "Proposed",
      "maintainer": {
        "@id": "https://standards.bundu.org/ecosystem#bundu-labs"
      }
    },
