    {
      "@type": "DefinedTermSet",
      "@id": "https://standards.bundu.org/ecosystem#terms",
      "name": "Bundu ecosystem terms",
      "hasDefinedTerm": [
        {
          "@type": "DefinedTerm",
          "@id": "https://standards.bundu.org/ecosystem#platform-tokens",
          "identifier": "platform-tokens",
          "name": "Platform tokens (MIT, MXT, NST, NHC)",
          "description": "A proposed Mukoko project and a future build-out, not on the current roadmap (owner, 2026-11-17). Four tokens are proposed: MIT (identity, soulbound) and MXT (exchange) for Mukoko, NST and NHC for the Nyuchi Honeycomb. Not in development, none issued, none on sale. Never described as live, scheduled or governed today.",
          "version": "0.1.0",
          "dateModified": "2026-11-17",
          "termCode": "platform-tokens",
          "inDefinedTermSet": {
            "@id": "https://standards.bundu.org/ecosystem#terms"
          }
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://standards.bundu.org/ecosystem#nyuchi-honeycomb",
          "identifier": "nyuchi-honeycomb",
          "name": "Nyuchi Honeycomb",
          "description": "The distributed, decentralised platform Nyuchi is building. Like a honeycomb, it holds cells: each person's data lives in their own pod. In development; never described as live.",
          "version": "1.0.0",
          "dateModified": "2026-11-17",
          "termCode": "nyuchi-honeycomb",
          "inDefinedTermSet": {
            "@id": "https://standards.bundu.org/ecosystem#terms"
          }
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://standards.bundu.org/ecosystem#pod",
          "identifier": "pod",
          "name": "Pod",
          "description": "A person's own store of data in the Nyuchi Honeycomb, made of cells. Today personal data lives on the device and syncs with cloud storage already isolated per person, so the move to pods is a simple migration.",
          "version": "1.0.0",
          "dateModified": "2026-11-17",
          "termCode": "pod",
          "inDefinedTermSet": {
            "@id": "https://standards.bundu.org/ecosystem#terms"
          }
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://standards.bundu.org/ecosystem#mukoko-apps",
          "identifier": "mukoko-apps",
          "name": "Mukoko apps",
          "description": "The apps inside the Mukoko platform, available in the super app and standalone in their own domains. Nhimbe, bushtrade, lingo and the other single-purpose brands are Mukoko apps.",
          "version": "1.0.0",
          "dateModified": "2026-11-17",
          "termCode": "mukoko-apps",
          "inDefinedTermSet": {
            "@id": "https://standards.bundu.org/ecosystem#terms"
          }
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://standards.bundu.org/ecosystem#frontier-infrastructure",
          "identifier": "frontier-infrastructure",
          "name": "Frontier infrastructure",
          "description": "Infrastructure engineered for places where bandwidth, devices and budgets are constrained, held to the seven engineering constraints.",
          "version": "1.0.0",
          "dateModified": "2026-11-17",
          "termCode": "frontier-infrastructure",
          "inDefinedTermSet": {
            "@id": "https://standards.bundu.org/ecosystem#terms"
          }
        },
        {
          "@type": "DefinedTerm",
          "@id": "https://standards.bundu.org/ecosystem#pricing-principle",
          "identifier": "pricing-principle",
          "name": "Pricing principle",
          "description": "Consumption is predominantly free. No forced upgrades, artificial usage limits or constant upselling. Commercial value comes from API consumption, integrations, partnerships, platform adoption, embedded services and data products, never from excluding the people the ecosystem exists to serve.",
          "version": "1.0.0",
          "dateModified": "2026-11-17",
          "termCode": "pricing-principle",
          "inDefinedTermSet": {
            "@id": "https://standards.bundu.org/ecosystem#terms"
          }
        }
      ]
    }
  ]
}
