---
// One tab of the register: the tabs, then the standards of one status, grouped by domain.
import Base from "../layouts/Base.astro";
import { REGISTER } from "../lib/data.js";
import Text from "./Text.astro";
import { TABS, domainsWith, tabJson, definedTermSet } from "../lib/register.js";

const { status } = Astro.props;
const tab = TABS.find((t) => t.status === status);
const domains = domainsWith(REGISTER, status);
const count = REGISTER.counts[status];
const title = status === "adopted" ? "Register · Bundu standards" : `${tab.label} · Register · Bundu standards`;
const lead =
  status === "adopted"
    ? `${count} adopted standards. The platform builds on these.`
    : `${count} proposed ${count === 1 ? "standard" : "standards"}, waiting for the owner's decision to adopt.`;
---
<Base
  title={title}
  description="Every external standard the platform adopts or proposes, and its status."
  jsonLd={status === "adopted" ? definedTermSet(REGISTER) : undefined}
  pageJson={tabJson(REGISTER, status, Astro.site?.origin)}
>
  <h1>Register</h1>
  <nav class="tabs" aria-label="Standards by status" data-md-skip>
    <ul>
      {TABS.map((t) => (
        <li>
          <a href={t.href} aria-current={t.status === status ? "page" : undefined}>
            {t.label} ({REGISTER.counts[t.status]})
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <p>{lead}</p>
  {domains.length > 1 && (
    <nav aria-labelledby="on-this-page" data-md-skip>
      <h2 id="on-this-page">On this page</h2>
      <ul class="toc">
        {domains.map((d) => (
          <li><a href={`#${d.key}`}>{d.title}</a></li>
        ))}
      </ul>
    </nav>
  )}
  {domains.map((d) => (
    <section aria-labelledby={d.key}>
      <h2 id={d.key} tabindex="-1">{d.title}</h2>
      <ul class="list">
        {d.standards.map((s) => (
          <li>
            <a href={`/register/${s.id}/`}>{s.name}</a>{" "}
            <span class={`chip ${s.status}`} data-md={` (${s.status})`}><span class="sr-only">Status: </span>{s.status}</span>
            <div class="muted"><Text text={s.current} inline /></div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
