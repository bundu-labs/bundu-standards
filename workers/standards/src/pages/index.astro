---
import Base from "../layouts/Base.astro";
import { REGISTER } from "../lib/data.js";
import { indexJson } from "../lib/register.js";
const { counts } = REGISTER;
---
<Base
  title="Bundu standards"
  description="The open standards the Bundu, Mukoko and Nyuchi platform builds on."
  pageJson={indexJson(REGISTER, Astro.site?.origin)}
>
  <h1>Bundu standards</h1>
  <p>If a standard exists, we adopt it. If none exists, we build one and publish it.</p>
  <p>
    Data from a source that does not match a standard is converted at the edge, and only the standard form is stored or
    served.
  </p>
  <p>
    The <a href="/register/">register</a> lists {counts.total} standards:{" "}
    <a href="/register/">{counts.adopted} adopted</a> and <a href="/register/proposed/">{counts.proposed} proposed</a>.
  </p>
  <h2>For other repositories</h2>
  <p>Read the register at a commit, with no credential. Pin the sha256 of each file.</p>
  <pre tabindex="0" role="region" aria-label="Example requests">GET /register/latest
GET /&lt;commit&gt;/register/register.yaml</pre>
</Base>
