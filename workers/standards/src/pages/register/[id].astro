---
import Base from "../../layouts/Base.astro";
import { REGISTER } from "../../lib/data.js";
import Text from "../../components/Text.astro";
import { definedTerm, paragraphs, standardJson, tabFor } from "../../lib/register.js";

export function getStaticPaths() {
  return REGISTER.standards.map((s) => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props;
const jsonLd = { "@context": "https://schema.org", ...definedTerm(s) };
const tab = tabFor(s);
const text = [
  ["Governs", s.governs],
  ["Current", s.current],
  ["Commitment", s.commitment],
  ["Steward", s.steward],
  ["Decided", s.decided],
];
---
<Base
  title={`${s.name} · Bundu standards`}
  description={paragraphs(s.governs).join(" ").replaceAll("`", "")}
  jsonLd={jsonLd}
  pageJson={standardJson(s, Astro.site?.origin)}
>
  <nav aria-label="Breadcrumb" data-md-skip>
    <p><a href={tab.href}><span aria-hidden="true">← </span>Register: {tab.label.toLowerCase()}</a></p>
  </nav>
  <h1>{s.name} <span class={`chip ${s.status}`} data-md={` (${s.status})`}><span class="sr-only">Status: </span>{s.status}</span></h1>
  <dl>
    {text.filter(([, v]) => v).map(([k, v]) => (
      <>
        <dt>{k}</dt>
        <dd><Text text={v} /></dd>
      </>
    ))}
    <dt>Specification</dt><dd><p><a href={s.url}>{s.url}</a></p></dd>
    {s.docs && (<><dt>Documentation</dt><dd><p><a href={s.docs}>{s.docs}</a></p></dd></>)}
    {s.notes && (<><dt>Notes</dt><dd><Text text={s.notes} /></dd></>)}
  </dl>
</Base>
