{
  // The Astro build of standards.bundu.org, retired: the custom domain belongs to the Rust
  // Worker (workers/standards-api), so this Worker claims no route. Astro generates the rest
  // of the Worker configuration.
  // No bindings and no secrets: the pages are built from the register in this
  // repository, and the file endpoint reads a public repository.
  "name": "bundu-standards",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
}
