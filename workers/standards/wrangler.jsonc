{
  // standards.bundu.org: the public, read-only address of the Bundu standards
  // register. No bindings and no secrets: it reads a public repository.
  "name": "bundu-standards",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "standards.bundu.org", "custom_domain": true }],
  "observability": { "enabled": true },
}
