{
  // The Astro build of standards.bundu.org, retired. The custom domain moved to
  // the Rust Worker (workers/standards-api) on 2026-11-17, so this Worker has
  // no route: a deploy of it must never take the domain back. Delete this
  // directory once the Rust Worker has run for a while (#87).
  // No bindings and no secrets.
  "name": "bundu-standards",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
}
